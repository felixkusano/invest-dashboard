# ─────────────────────────────────────────────────────────────
# Investment Desk: Umgebungsvariablen
# Kopieren nach .env.local (lokal) bzw. im Vercel-Projekt hinterlegen.
# Niemals echte Werte in das Repository einchecken.
# ─────────────────────────────────────────────────────────────

# Anmeldung (Pflicht)
ADMIN_EMAIL=you@example.com
# Hash erzeugen mit: npm run hash-password -- "langes Passwort"
ADMIN_PASSWORD_HASH=
# Nur lokal und ohne Hash: Klartext-Passwort (in Produktion ignoriert)
# ADMIN_PASSWORD=
# Mindestens 32 zufällige Zeichen, z. B. openssl rand -base64 48
SESSION_SECRET=

# Datenbank. Leer = lokale PGlite-Datei unter ./data/pglite (nur Entwicklung).
# Produktion: Supabase Connection String (Transaction Pooler, Port 6543)
DATABASE_URL=
# DATABASE_POOL_MAX=5

# Zeitplan-Authentifizierung für /api/cron/daily (Vercel Cron sendet "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Kurse (primär): EODHD, deckt US, XETRA, Oslo, Euronext und UCITS-ETFs ab. Datentyp Tagesschluss.
EODHD_API_KEY=
# true, wenn der Plan Fundamentaldaten enthält (Fundamentals oder All-in-One)
EODHD_FUNDAMENTALS=false
# true, um EODHD-News zusätzlich zu nutzen (5 Credits je Abruf)
EODHD_NEWS=false

# US-Kurse (Fallback), Unternehmensnews, Kennzahlen, Earnings-Kalender. Free Tier nur US-Titel.
FINNHUB_API_KEY=
# true bei kostenpflichtigem Finnhub-Plan mit internationaler Abdeckung
FINNHUB_PREMIUM=false

# US-Makrodaten, Renditen, Spreads, Rohstoffe, S&P 500, Nasdaq-100, VIX (kostenloser Key)
FRED_API_KEY=

# KI-Analyse. Ohne Key: regelbasierter Report, klar gekennzeichnet.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optionale E-Mail-Benachrichtigungen über Resend
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
